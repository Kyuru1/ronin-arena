# PostgreSQL local. Substitute USER and PASSWORD with your PostgreSQL credentials.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ronin_arena

# Addresses allowed to call the API. Keep localhost during development.
CORS_ORIGIN=http://localhost:5173,https://kyuru1.github.io

# API port. The game defaults to http://localhost:3001/api.
PORT=3001
